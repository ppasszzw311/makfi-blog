---
import '@/styles/PortfolioPage.css'
import Icon from '@/components/Icon.astro'
import { defaultLang, type Lang, useTranslations } from '@/i18n/ui'
import { mdiCodeBraces, mdiImageOutline, mdiWeb } from '@/lib/icons'
import type { PortfolioItem } from '@/lib/portfolio'

interface Props {
  lang?: Lang
  items: PortfolioItem[]
}

const { lang = defaultLang, items } = Astro.props
const t = useTranslations(lang)
---

<div class="mx-auto mt-8 max-w-[1000px]">
  <header class="mb-10 text-center">
    <h1 class="font-serif text-[1.75rem] font-bold text-ink">{t('nav.portfolio')}</h1>
    <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-2">
      {t('portfolio.subtitle')}
    </p>
  </header>

  {
    items.length === 0 ? (
      <div class="portfolio-empty">
        <Icon d={mdiImageOutline} class="portfolio-empty-icon" />
        <p class="portfolio-empty-title">{t('portfolio.emptyTitle')}</p>
        <p class="portfolio-empty-sub" set:html={t('portfolio.emptySub', { config: '<code>src/site.config.ts</code>' })} />
      </div>
    ) : (
      <div class="grid gap-5 sm:grid-cols-2">
        {items.map((item, i) => (
          <article class="portfolio-card" style={`--stagger: ${Math.min(i, 8) * 60}ms`}>
            <div class="portfolio-thumb">
              {item.image ? (
                <img src={item.image} alt={item.title} loading="lazy" decoding="async" />
              ) : (
                <span class="portfolio-thumb-fallback" aria-hidden="true">
                  <Icon d={mdiImageOutline} />
                </span>
              )}
            </div>

            <div class="portfolio-body">
              <div class="portfolio-head">
                <h2 class="portfolio-title">{item.title}</h2>
                {item.period && <span class="portfolio-period">{item.period}</span>}
              </div>

              {item.description && <p class="portfolio-desc">{item.description}</p>}

              {item.tags.length > 0 && (
                <div class="portfolio-tags">
                  {item.tags.map((tag) => (
                    <span class="portfolio-tag">{tag}</span>
                  ))}
                </div>
              )}

              {(item.url || item.repoUrl) && (
                <div class="portfolio-links">
                  {item.url && (
                    <a href={item.url} target="_blank" rel="noopener noreferrer" class="portfolio-link">
                      <Icon d={mdiWeb} class="text-sm" />
                      {t('portfolio.liveLabel')}
                    </a>
                  )}
                  {item.repoUrl && (
                    <a href={item.repoUrl} target="_blank" rel="noopener noreferrer" class="portfolio-link">
                      <Icon d={mdiCodeBraces} class="text-sm" />
                      {t('portfolio.repoLabel')}
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )
  }
</div>
